###################
## Local mode
###################
# For local development (*.docker.localhost), leave DOMAIN_NAME and USER_EMAIL empty.
# Traefik will use mkcert certificates from traefik-config/certs/.
# Run: make setup-local && make up-local

###################
## Production mode
###################
# For production (public FQDN + Let's Encrypt), fill in all fields below.
# Run: make setup-prod && make up-prod

# Your base domain — services will be exposed as <service>.<DOMAIN_NAME>
DOMAIN_NAME=

# Email used for Let's Encrypt certificate registration
USER_EMAIL=

###################
## Traefik dashboard
###################
# Generate credentials with:
#    htpasswd -n <username>
# Copy the printed <username> and <password> below.
# IMPORTANT: replace every $ with $$ in TRAEFIK_PASSWORD to escape it for Docker.
TRAEFIK_USERNAME=
TRAEFIK_PASSWORD=
